{
  "name": "fullstack-template",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "mounts": [
    "source=${localEnv:HOME}/.npmrc,target=/home/node/.npmrc,type=bind,consistency=cached"
  ],
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "MS-CEINTL.vscode-language-pack-ja",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "Gruntfuggly.todo-tree",
        "Postman.postman-for-vscode",
        "yoavbls.pretty-ts-errors",
        "mtxr.sqltools-driver-pg",
        "Prisma.prisma",
        "rodrigovallades.es7-react-js-snippets",
        "formulahendry.auto-rename-tag"
      ],
      "search.exclude": {
        ".pnpm-store": true,
        ".turbo": true,
        "node_modules": true,
        "dist": true,
        ".next": true
      },
      "settings": {
        // --- Editor ---
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "always",
          "source.addMissingImports.ts": "always"
        },
        // --- Language-specific formatters ---
        "[prisma]": {
          "editor.defaultFormatter": "Prisma.prisma"
        },
        // --- Files ---
        "files.eol": "\n",
        // --- ESLint (monorepo: resolve config per package) ---
        "eslint.enable": true,
        "eslint.workingDirectories": [{ "pattern": "./apps/*/" }, { "pattern": "./packages/*/" }],
        // --- TypeScript (use workspace TypeScript instead of VS Code built-in) ---
        "typescript.tsdk": "node_modules/typescript/lib",
        // --- Prisma ---
        "prisma.pinToPrisma6": true,
        // --- SQLTools ---
        "sqltools.connections": [
          {
            "previewLimit": 50,
            "server": "db",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "fullstack-template-connection",
            "database": "postgres",
            "username": "postgres",
            "password": "postgres"
          }
        ]
      }
    }
  },
  "forwardPorts": [3000]
}
