{
  "name": "@takuya-ichikawa/public-template",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": "https://github.com/takuya-ichikawa/frontendtemplate",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules tsconfig.tsbuildinfo",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@takuya-ichikawa/eslint-config-base": "workspace:*",
    "@takuya-ichikawa/typescript-config": "workspace:*",
    "eslint": "^9.0.0"
  }
}
