{
  "name": "@takuya-ichikawa/api-types",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules tsconfig.tsbuildinfo",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "types:generate": "openapi-typescript src/__generated__/openapi.json -o src/__generated__/generated.ts",
    "map:generate": "node scripts/generate-operation-map.mjs",
    "generate": "pnpm run types:generate && pnpm run map:generate"
  },
  "devDependencies": {
    "@takuya-ichikawa/eslint-config-base": "workspace:*",
    "@takuya-ichikawa/typescript-config": "workspace:*",
    "eslint": "^9.0.0",
    "openapi-typescript": "^7.13.0"
  }
}
