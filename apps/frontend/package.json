    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@takuya-ichikawa/eslint-config-base": "workspace:*",
    "@takuya-ichikawa/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6"
